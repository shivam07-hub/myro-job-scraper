# Copy to .env and fill in values

# ── Open-weight inference ────────────────────────────────────────────────────
# Local default: LM Studio's OpenAI-compatible server.
INFERENCE_BASE_URL=http://localhost:1234/v1
INFERENCE_API_KEY=lm-studio
INFERENCE_MODEL=your-open-weight-model-id
# Required by the forward worker: deterministic evidence still grounds skills,
# while the LLM always supplies the trust-facing summary and role domain.
ENRICH_FORCE_LLM=1

# Source-first semantic retrieval (local LM Studio only).  This model is
# independent from the generative enrichment model above and must remain
# identical to the model Myro uses for `search_query:` embeddings.
JOB_EMBEDDING_BASE_URL=http://localhost:1234/v1
JOB_EMBEDDING_API_KEY=lm-studio
JOB_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
JOB_EMBEDDING_DIMENSIONS=768

# Remote option: use an approved OpenAI-compatible endpoint that serves
# open-weight models. Remote endpoints require an explicit allowlist.
# INFERENCE_BASE_URL=https://your-approved-open-weight-host/v1
# INFERENCE_API_KEY=your-provider-token-or-placeholder
# INFERENCE_MODEL=google/gemma-3-4b
# OPEN_WEIGHT_MODEL_ALLOWLIST=google/gemma-3-4b
#
# Cloudflare Workers AI option (OpenAI-compatible, open-weight model allowlisted):
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-workers-ai-api-token
# CLOUDFLARE_WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
# CLOUDFLARE_WORKERS_AI_MODEL_ALLOWLIST=@cf/meta/llama-3.1-8b-instruct-fp8-fast
# The scraper will derive:
# INFERENCE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account-id>/ai/v1
# INFERENCE_API_KEY=<cloudflare-token>

# Backward-compatible names still work if your local setup already uses them:
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# LM_STUDIO_API_KEY=lm-studio
# LM_STUDIO_MODEL=your-model-name-here

# ── Local Firecrawl ───────────────────────────────────────────────────────────
FIRECRAWL_URL=http://localhost:3002
FIRECRAWL_CLOUD_API_KEY=

# ── Optional overrides ────────────────────────────────────────────────────────
# PORTALS_PATH=/absolute/path/to/KNOWN_PORTALS.md
# OUTPUT_BASE=/absolute/path/to/All_CSV_Outputs
# WORKDAY_PAGE_SIZE=20
# REQUEST_TIMEOUT=30
# FIRECRAWL_CRAWL_LIMIT=40
# FIRECRAWL_POLL_SECS=90
# LLM_JD_CHAR_LIMIT=2000
